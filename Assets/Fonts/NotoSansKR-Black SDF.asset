    characterSetSelectionMode: 7
    characterSequence: "\uC90D\uAE30 \uCEF4\uD4E8\uD130\uC5D0 \uAF42\uAE30 \uC5F4\uAE30
      \uB2F9\uAE30\uAE30 \uB07C\uC6B0\uAE30 \uC804\uAD6C \uCC22\uC5B4\uC9C4 \uD3EC\uC2A4\uD2B8\uC7871234567890:
      USB \uB3CC\uB9AC\uAE30\uBC29 \uC5B4\uB518\uAC00\uC5D0 \r\nUSB\uB97C \uC228\uACA8\uB193\uC558\uC5B4\uC694...\uC22B\uC790\uB97C
      \uC785\uB825\uD558\uC138\uC694\uB4E4\uC5B4\uC62C\uB9AC\uAE30\uB0B4\uB824\uB193\uAE30
      \uB2EB\uAE30\uB97C\uB20C\uB7EC\uB2EB\uC785\uB825\uBE44\uBC00\uBC88\uD638\uB97C\uD578\uB4DC\uD3F0\uC790\uBB3C\uC1E0\uD480\uAE30\uBE44\uBC00\uBC88\uD638\uB97C\n\uBC29\uC774
      \uC5B4\uB450\uC6CC \uBA3C\uC800 \uBC1D\uD600\uC57C\uACA0\uB2E4..\uC774\uC81C
      \uC8FC\uBCC0\uC744 \uC81C\uB300\uB85C \uBCFC \uC218 \uC788\uB2E4. \uBB34\uC5B8\uAC00
      \uC774\uC0C1\uD55C \uC561\uC790\uAC00 \uBCF4\uC778\uB2E4..\uC5B4\uB518\uAC00
      \uC5F4\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4. \uD655\uC778\uD574\uBCF4\uC790.\uCC22\uC5B4\uC9C4
      \uC885\uC774 \uC870\uAC01\uB4E4... \uB0A0\uC9DC\uAC00 \uC801\uD600\uC788\uB2E4.
      \uBB54\uAC00\uC758 \uBE44\uBC00\uBC88\uD638\uC77C\uAE4C?\uCC45\uC0C1 \uC11C\uB78D
      \uC548\uC5D0 \uD578\uB4DC\uD3F0\uC774 \uC788\uB2E4. \uBE44\uBC00\uBC88\uD638\uB97C
      \uC785\uB825\uD574\uBCF4\uC790.\uD578\uB4DC\uD3F0\uC758 \uBA54\uC2DC\uC9C0...
      USB\uAC00 \uC228\uACA8\uC838 \uC788\uB2E4\uACE0?\"USB\uB97C \uCC3E\uC558\uB2E4.
      \uCEF4\uD4E8\uD130\uC5D0 \uC5F0\uACB0\uD574\uC2DC\uAC04\uC774 \uB2E4 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uAC8C\uC784 \uC624\uBC84!\uC11C \uBB50\uAC00 \uC788\uB294\uC9C0 \uD655\uC778\uD574\uBCF4\uC790.\uAC8C\uC784
      \uC644\uB8CC! \uCD95\uD558\uD569\uB2C8\uB2E4!\n\uADF8 \uC601\uC0C1\uC774 \uB2F4\uC740
      \uC9C4\uC2E4\uC744 \uB9C8\uC8FC\uD588\uB2E4.\n\uC0AC\uAC74\uC758 \uC804\uB9D0\uC744
      \uC54C\uAC8C \uB418\uC5C8\uACE0,\n\uB098\uB294 \uC774 \uBC29\uC744 \uB5A0\uB0A0
      \uC218 \uC788\uAC8C \uB410\uB2E4.\n\uBAA8\uB4E0 \uAC83\uC774 \uB05D\uB0AC\uB2E4.\n\uC2DC\uAC04\uC774
      \uBD80\uC871\uD588\uB2E4.\n\uC99D\uAC70\uB97C \uCC3E\uC9C0 \uBABB\uD588\uACE0,\n\uC0AC\uAC74\uC740
      \uBBF8\uAD81 \uC18D\uC5D0 \uC0AC\uB77C\uC84C\uB2E4.\n\uBAA8\uB4E0 \uAC83\uC774
      \uB05D\uB098\uBC84\uB838\uB2E4.\nW, A, S, D - \uC774\uB3D9\nE - \uC0C1\uD638\uC791\uC6A9\nQ
      - \uC544\uC774\uD15C \uC790\uC138\uD788 \uBCF4\uAE30\n\uB9C8\uC6B0\uC2A4 -
      \uD654\uBA74 \uD68C\uC804"
